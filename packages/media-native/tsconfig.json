{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "rootDir": "./src",
    "outDir": "./dist",

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "strict": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,

    "jsx": "react-jsx",

    "paths": {
      "@media-sdk/core": [
        "../media-core/dist/index.d.ts"
      ]
    },

    "types": [
      "react"
    ]
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}