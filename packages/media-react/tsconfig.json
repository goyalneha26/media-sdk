{
  "compilerOptions": {

    "target": "ES2020",

    "module": "ESNext",

    "moduleResolution": "Bundler",

    "jsx": "react-jsx",

    "rootDir": "./src",

    "outDir": "./dist",

    "declaration": true,

    "declarationMap": true,

    "strict": true,

    "verbatimModuleSyntax": true,

    "skipLibCheck": true

  },

  "include": [
    "src"
  ]
}